#  FinanceHub — monorepo .gitignore
#  Covers: backend (Node/Express), frontend (CRA), dashboard (CRA)


#  Environment / secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.production
*.env

#  Node modules (all three apps) 
node_modules/
**/node_modules/

# Build output
build/
dist/
**/build/
**/dist/

# React / CRA cache 
.cache/
**/.cache/

#  Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

#  OS files 
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

#  Editor / IDE 
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

#  Test coverage
coverage/
**/coverage/
.nyc_output/

#  Misc
*.pem
*.key
*.crt
.tmp/
tmp/
